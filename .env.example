# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/parque_dotacion_db?schema=public"

# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Swagger
SWAGGER_TITLE=Parque Dotación API
SWAGGER_DESCRIPTION=API para gestión de parques y dotaciones
SWAGGER_VERSION=1.0


# Configuración de variables que usa NestJS u otras partes del backend
BACKEND_PORT=3000

DB_HOST=db
DB_PORT=5432
DB_USERNAME=username
DB_PASSWORD=password
DB_NAME=parque_dotacion_db