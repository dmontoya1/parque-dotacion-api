generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  userType  String   @map("user_type") @db.VarChar(50)
  password  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  allocationSchedules AllocationSchedule[]
  agendas             Agenda[]

  @@map("us_users")
}

// Park model
model Park {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  address   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  stageAllocations StageAllocation[]

  @@map("gn_parks")
}

// ActivityCategory model
model ActivityCategory {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  priorityLevel Int      @map("priority_level")
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  allocationSchedules AllocationSchedule[]

  @@map("gn_activity_categories")
}

// StageAllocation model
model StageAllocation {
  id        Int      @id @default(autoincrement())
  parkId    Int      @map("park_id")
  name      String   @db.VarChar(255)
  address   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  park                Park                 @relation(fields: [parkId], references: [id], onDelete: Cascade)
  allocationSchedules AllocationSchedule[]

  partitions Partition[] @relation("StagePartition")
  agendas    Agenda[]

  @@map("gn_stage_allocations")
}

// AllocationSchedule model
model AllocationSchedule {
  id                 Int      @id @default(autoincrement())
  activityCategoryId Int      @map("activity_category_id")
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  stageAllocationId  Int      @map("stage_allocation_id")
  userId             Int      @map("user_id")
  day                String   @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  activityCategory ActivityCategory @relation(fields: [activityCategoryId], references: [id], onDelete: Cascade)
  stageAllocation  StageAllocation  @relation(fields: [stageAllocationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gn_allocation_schedules")
}

// Partition model
model Partition {
  id                Int      @id @default(autoincrement())
  stageAllocationId Int      @map("stage_allocation_id")
  name              String   @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  stageAllocation   StageAllocation    @relation("StagePartition", fields: [stageAllocationId], references: [id])
  partitionSegments PartitionSegment[]
  agendas           Agenda[]

  @@map("gn_partitions")
}

// PartitionSegment model
model PartitionSegment {
  id          Int      @id @default(autoincrement())
  partitionId Int      @map("partition_id")
  name        String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  partition Partition @relation(fields: [partitionId], references: [id], onDelete: Cascade)
  agendas   Agenda[]

  @@map("gn_partition_segments")
}

// Agenda model
model Agenda {
  id                 Int      @id @default(autoincrement())
  stageAllocationId  Int?     @map("stage_allocation_id")
  partitionId        Int?     @map("partition_id")
  partitionSegmentId Int?     @map("partition_segment_id")
  userId             Int      @map("user_id")
  startDate          DateTime @map("start_date")
  endDate            DateTime @map("end_date")
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  stageAllocation  StageAllocation?  @relation(fields: [stageAllocationId], references: [id], onDelete: Cascade)
  partition        Partition?        @relation(fields: [partitionId], references: [id], onDelete: Cascade)
  partitionSegment PartitionSegment? @relation(fields: [partitionSegmentId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gn_agendas")
}
